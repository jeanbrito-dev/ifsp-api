generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  USUARIO
  ADMIN
}

enum StatusEvento {
  RASCUNHO
  PUBLICADO
  CANCELADO
  REALIZADO
}
model Usuario {
  id    String @id @default(uuid()) @db.Uuid  
  nome  String
  email String @unique
  senha String
  cargo TipoUsuario @default(USUARIO)
  instituicoesSeguidas InstituicaoSeguidor[]

  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime? @updatedAt @db.Timestamptz(3)

  eventosCriados Evento[] @relation("CriadorEvento")
  favoritos Favorito[]
  comentarios Comentario[]
  codigosResetSenha CodigoResetSenha[]
}
model Evento {
  id String @id @default(uuid()) @db.Uuid
  titulo String
  descricao String
  local String?
  imagemUrl String?
  inicioEm DateTime @db.Timestamptz(3)
  finalEm DateTime @db.Timestamptz(3)
  registroUrl String?
  status StatusEvento @default(RASCUNHO)

  instituicaoId String @db.Uuid
  categoriaId String? @db.Uuid
  criadoPorId String @db.Uuid

  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  instituicao Instituicao @relation(fields: [instituicaoId], references: [id])
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  criadoPor Usuario @relation("CriadorEvento", fields: [criadoPorId], references: [id])

  favoritos Favorito[]
  comentarios Comentario[]

  @@index([status, inicioEm])
  @@index([instituicaoId])
  @@index([categoriaId])
}

model Instituicao {
  id String @id @default(uuid()) @db.Uuid
  nome String
  slug String @unique
  descricao String?
  logoUrl String?
  seguidores InstituicaoSeguidor[]

  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  eventos Evento[]
}

model InstituicaoSeguidor {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @db.Uuid
  instituicaoId String   @db.Uuid

  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  instituicao Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, instituicaoId])
  @@index([instituicaoId, criadoEm])
}

model Categoria {
  id String @id @default(uuid()) @db.Uuid
  nome String
  slug String @unique

  eventos Evento[]
}

model Favorito {
  id String @id @default(uuid()) @db.Uuid
  usuarioId String @db.Uuid 
  eventoId String @db.Uuid 

  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model Comentario {
  id String @id @default(uuid()) @db.Uuid
  conteudo String
  usuarioId String @db.Uuid
  eventoId String @db.Uuid

  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId, criadoEm])
}

model CodigoResetSenha {
  id String @id @default(uuid()) @db.Uuid
  codigo String
  expiraEm DateTime @db.Timestamptz(3)
  usadoEm DateTime? @db.Timestamptz(3)

  usuarioId String @db.Uuid
  criadoEm DateTime @default(now()) @db.Timestamptz(3)
  
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraEm])
}

model Homenagem {
  id            Int      @id @default(autoincrement())
  titulo        String
  homenageado   String
  descricao     String
  fotoUrl       String?
  data          DateTime
  criadoPorId   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("homenagens")
}

enum TipoEvento {
  FERIADO
  PROVA
  RECESSO
  MATRICULA
  INICIO_AULAS
  FIM_AULAS
  OUTRO
}

model EventoCalendario {
  id         Int        @id @default(autoincrement())
  titulo     String
  descricao  String?
  dataInicio DateTime
  dataFim    DateTime?
  tipo       TipoEvento @default(OUTRO)
  campus     String?
  anoLetivo  Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([anoLetivo, dataInicio])
  @@map("eventos_calendario")
}

enum CategoriaDocumento {
  EDITAL
  PORTARIA
  RESOLUCAO
  OUTRO
}

model Documento {
  id              Int                @id @default(autoincrement())
  titulo          String
  descricao       String?
  categoria       CategoriaDocumento
  arquivoNome     String
  arquivoPath     String
  arquivoMimetype String
  arquivoTamanho  Int
  dataPublicacao  DateTime           @default(now())
  ativo           Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([categoria, dataPublicacao])
  @@map("documentos")
}